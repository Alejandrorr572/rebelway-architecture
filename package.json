{
  "name": "musical-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para microservicios de Música con TypeScript",
  "workspaces": [
    "config-global",
    "services/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "build:authors": "npm run build -w services/authors-service",
    "dev:authors": "npm run dev -w services/authors-service"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}