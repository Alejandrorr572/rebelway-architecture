{
  "name": "musical-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para microservicios de Música con TypeScript",
  "workspaces": [
    "config-global",
    "services/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "build:artist": "npm run build -w services/artist-service",
    "dev:artist": "npm run dev -w services/artist-service",
    "build:song": "npm run build -w services/song-service",
    "dev:song": "npm run dev -w services/song-service",
    "test": "jest",
    "test:artist": "jest services/artist-service",
    "test:song": "jest services/song-service"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "braces": "^3.0.3"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
